APPLICATION_PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONN_URL=postgres://postgres:postgres@postgres:5432/links
POSTGRES_DB=links
POSTGRES_MIN_CONN=2 
POSTGRES_MAX_CONN=10 
POSTGRES_MAX_LIFETIME=1h

REDIS_ADDR=redis:6379
REDIS_PASSWORD=redispass
REDIS_USER=default
REDIS_DB=0
REDIS_PROTOCOL=2
REDIS_MAX_RETRIES=5
REDIS_DIAL_TIMEOUT=10s
REDIS_TIMEOUT=5s
REDIS_MAX_LIFETIME=1h